{
    "name": "@7h3laughingman/pf2e-types",
    "version": "8.0.0",
    "description": "Basic TypeScript types for PF2e",
    "homepage": "https://github.com/7H3LaughingMan/pf2e-types#readme",
    "bugs": {
        "url": "https://github.com/7H3LaughingMan/pf2e-types/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/7H3LaughingMan/pf2e-types.git"
    },
    "license": "MIT",
    "author": "7H3LaughingMan <7H3LaughingMan@proton.me> (https://github.com/7H3LaughingMan)",
    "funding": "https://ko-fi.com/7h3laughingman",
    "type": "module",
    "imports": {
        "#actor": "./src/module/actor/index.js",
        "#actor/*": "./src/module/actor/*",
        "#item": "./src/module/item/index.js",
        "#item/*": "./src/module/item/*",
        "#scene": "./src/module/scene/index.js",
        "#scene/*": "./src/module/scene/*",
        "#system/*": "./src/module/system/*",
        "#module/*": "./src/module/*",
        "#scripts/*": "./src/scripts/*",
        "#common/*": "@7h3laughingman/foundry-types/common/*",
        "#client/*": "@7h3laughingman/foundry-types/client/*",
        "#util": "./src/util/index.js",
        "#util/*": "./src/util/*"
    },
    "exports": {
        ".": "./src/index.d.ts",
        "./module/*": "./src/module/*",
        "./scripts/*": "./src/scripts/*",
        "./utils/*": "./src/utils/*"
    },
    "files": [
        "./src/*",
        "./static/*"
    ],
    "scripts": {
        "tsc": "tsc",
        "eslint": "eslint src",
        "eslint:fix": "eslint src --fix && prettier src --write",
        "prepare": "husky"
    },
    "lint-staged": {
        "*.{ts,mts,cts,tsc,js,mjs,cjs,jsx}": [
            "eslint --fix",
            "prettier --write"
        ]
    },
    "dependencies": {
        "@7h3laughingman/foundry-types": "~14.360.2",
        "@codemirror/lang-html": "^6.4.11",
        "@codemirror/lang-javascript": "^6.2.5",
        "@codemirror/lang-json": "^6.0.2",
        "@codemirror/lang-markdown": "^6.5.0",
        "@codemirror/state": "^6.6.0",
        "@pixi/graphics-smooth": "^1.1.1",
        "@pixi/particle-emitter": "^5.0.10",
        "@types/jquery": "^3.5.34",
        "@types/luxon": "^3.7.1",
        "@types/simple-peer": "^9.11.9",
        "@types/sortablejs": "^1.15.9",
        "@types/tooltipster": "^0.0.35",
        "@types/ws": "^8.18.1",
        "@types/yaireo__tagify": "4.17.0",
        "@yaireo/tagify": "4.16.4",
        "codemirror": "^6.0.2",
        "gsap": "3.11.0",
        "handlebars": "^4.7.9",
        "jquery": "^3.7.1",
        "luxon": "^3.7.2",
        "minisearch": "^7.2.0",
        "peggy": "^4.2.0",
        "pixi.js": "^7.4.3",
        "prosemirror-collab": "^1.3.1",
        "prosemirror-commands": "^1.7.1",
        "prosemirror-dropcursor": "^1.8.2",
        "prosemirror-gapcursor": "^1.4.1",
        "prosemirror-history": "^1.5.0",
        "prosemirror-inputrules": "^1.5.1",
        "prosemirror-keymap": "^1.2.3",
        "prosemirror-model": "^1.25.4",
        "prosemirror-schema-list": "^1.5.1",
        "prosemirror-state": "^1.4.4",
        "prosemirror-tables": "^1.8.5",
        "prosemirror-transform": "^1.12.0",
        "prosemirror-view": "^1.41.8",
        "showdown": "^2.1.0",
        "simple-peer": "^9.11.1",
        "socket.io": "^4.8.3",
        "socket.io-client": "^4.8.3",
        "sortablejs": "^1.15.7",
        "svelte": "^5.55.4"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@eslint/json": "^1.2.0",
        "eslint": "^10.2.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.5",
        "glob": "^13.0.6",
        "husky": "^9.1.7",
        "lint-staged": "^16.4.0",
        "prettier-plugin-organize-imports": "^4.3.0",
        "typescript": "5.9.3",
        "typescript-eslint": "^8.58.2"
    },
    "engines": {
        "node": ">=24"
    },
    "sideEffects": false,
    "packageManager": "pnpm@10.30.3+sha512.c961d1e0a2d8e354ecaa5166b822516668b7f44cb5bd95122d590dd81922f606f5473b6d23ec4a5be05e7fcd18e8488d47d978bbe981872f1145d06e9a740017"
}
